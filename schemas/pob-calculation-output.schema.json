{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://path-of-everything.local/schemas/pob-calculation-output.schema.json",
  "title": "PoB calculation output",
  "type": "object",
  "required": ["schemaVersion", "exportType", "engine", "selection", "inputs", "normalized", "calculation"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "exportType": { "const": "pob-calculation" },
    "engine": { "type": "object", "additionalProperties": true },
    "build": { "type": "object", "additionalProperties": true },
    "selection": { "type": "object", "additionalProperties": true },
    "scenario": { "type": "object", "additionalProperties": true },
    "inputs": {
      "type": "object",
      "required": ["config", "skills", "items", "tree"],
      "additionalProperties": true
    },
    "normalized": { "type": "object", "additionalProperties": true },
    "calculation": {
      "type": "object",
      "required": ["mainOutput"],
      "additionalProperties": true
    },
    "limits": { "type": "object", "additionalProperties": true },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}

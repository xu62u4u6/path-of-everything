{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://path-of-everything.local/schemas/pob-calculation-input.schema.json",
  "title": "PoB calculation input",
  "type": "object",
  "required": ["selection"],
  "properties": {
    "build": { "type": "string", "description": "Local XML path or an imported build identifier." },
    "selection": {
      "type": "object",
      "properties": {
        "socketGroup": { "type": "integer", "minimum": 1 },
        "activeSkill": { "type": "integer", "minimum": 1 },
        "skillPart": { "type": "integer", "minimum": 1 },
        "minionSkill": { "type": "integer", "minimum": 1 },
        "minionItemSet": { "type": "integer", "minimum": 1 },
        "weaponSet": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "scenario": { "type": "object", "additionalProperties": true },
    "config": {
      "type": "object",
      "description": "PoB configuration fields supported by the bridge, such as enemy resistances, charges, and boss state.",
      "additionalProperties": true
    },
    "options": {
      "type": "object",
      "properties": {
        "maxDepth": { "type": "integer", "minimum": 2, "maximum": 16 },
        "maxKeys": { "type": "integer", "minimum": 100, "maximum": 100000 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
